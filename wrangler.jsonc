{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "militant-discord-interactions",
  "main": "src/cloudflare/worker.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "DISCORD_APPLICATION_ID": "1525606439500910682",
    "DISCORD_GUILD_ID": "805908199541702666",
    "DISCORD_LOOT_LOG_CHANNEL_ID": "1492400020958351391"
  },
  "observability": {
    "enabled": true
  },
  "queues": {
    "producers": [
      {
        "binding": "LOOT_UPLOAD_QUEUE",
        "queue": "militant-loot-uploads"
      }
    ],
    "consumers": [
      {
        "queue": "militant-loot-uploads",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "retry_delay": 5
      }
    ]
  }
}
